# You can set api keys here but could be risky to be seen by an agent, so I prefer to keep them at OS level
# API Key for GPT IMAGE 2
# OPENAI_API_KEY=
# GPT model used to describe and rank references (optional).
OPENAI_REFERENCE_MODEL=gpt-5.6-luna
# A token with read access to the private Space and private LoRA repositories.
# HF_TOKEN=

# Full Space URL, e.g. https://<owner>-qwen-image-lora-studio.hf.space
HF_SPACE_URL=
